#!/usr/bin/env bash
#
# cleancodeshit: interactive cleanup of developer tool caches and Docker disk space.
#
# 1. Scans every cache it knows about and shows what each one uses.
# 2. Asks which ones to clean (numbers, ranges, names or presets).
# 3. Shows the plan and asks for confirmation.
# 4. Cleans, one item at a time, with live progress.
# 5. Scans again and shows what was freed, item by item.
#
# Nothing is removed without confirmation. Anything that can lose data (Docker
# volumes, running containers) needs "yes" typed in full and is never part of a
# preset. Runs that clean write a private log in the user's log directory.
#
# Works with the bash 3.2 that ships with macOS. Run `cleancodeshit --help` for options.
# The item table dispatches probes and cleanup functions by name.
# shellcheck disable=SC2329

set -o pipefail

VERSION="2.1.0"
PROG="${0##*/}"

# ----------------------------------------------------------------------------
# Options
# ----------------------------------------------------------------------------

MODE="interactive"      # interactive | list
DRY_RUN=0
ASSUME_YES=0
PRESELECT=""
USE_COLOR=1
STALE_ROOT=""
STALE_REQUESTED=0
STALE_DAYS=30
STALE_DAYS_SET=0

usage() {
  cat <<EOF
$PROG $VERSION: free disk space used by developer tool caches and Docker.

Usage:
  $PROG                       scan, choose, confirm, clean, report
  $PROG --list                scan and show usage only; change nothing
  $PROG --dry-run             go through the whole flow but run nothing
  $PROG --select ITEMS        preselect items and skip the picker
  $PROG --select ITEMS --yes  clean without any prompt (safe and caution items only)

ITEMS is a list of numbers, ranges, item names or presets, separated by
spaces or commas, for example "1 3 5-7", "npm,uv,dk_build" or "safe".
  safe   every item marked safe
  all    every safe and caution item, except opt-in stale folders

Options:
  -l, --list        show usage and exit
  -n, --dry-run     show what would run; change nothing
  -s, --select L    preselect items (see above)
  -y, --yes         do not ask for confirmation (refuses danger items)
      --in DIR      include stale project folders under DIR in your home
      --older-than DAYS
                    project inactivity threshold (default: 30 days)
      --no-color    plain output (also honoured: NO_COLOR=1)
      --ascii       ASCII symbols only
  -h, --help        this help
  -V, --version     print the version

Risk levels:
  safe     a cache the tool rebuilds or re-downloads on demand
  caution  re-download is slow or large, or it removes old versions
  danger   can lose data; needs "yes" typed in full, never in a preset
EOF
}

ASCII_ONLY="${CLEANCODESHIT_ASCII:-0}"
while [ $# -gt 0 ]; do
  case "$1" in
    -l|--list) MODE="list" ;;
    -n|--dry-run) DRY_RUN=1 ;;
    -y|--yes) ASSUME_YES=1 ;;
    -s|--select)
      [ $# -ge 2 ] || { echo "$PROG: --select needs a value" >&2; exit 2; }
      PRESELECT="$2"; shift ;;
    --select=*) PRESELECT="${1#--select=}" ;;
    --in|--older-than)
      [ $# -ge 2 ] || { echo "$PROG: $1 needs a value" >&2; exit 2; }
      if [ "$1" = --in ]; then STALE_ROOT="$2"; STALE_REQUESTED=1
      else STALE_DAYS="$2"; STALE_DAYS_SET=1; fi
      shift ;;
    --in=*) STALE_ROOT="${1#*=}"; STALE_REQUESTED=1 ;;
    --older-than=*) STALE_DAYS="${1#*=}"; STALE_DAYS_SET=1 ;;
    --no-color) USE_COLOR=0 ;;
    --ascii) ASCII_ONLY=1 ;;
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "$PROG $VERSION"; exit 0 ;;
    *) echo "$PROG: unknown option '$1' (try --help)" >&2; exit 2 ;;
  esac
  shift
done

if [ "$(id -u)" -eq 0 ]; then
  echo "$PROG: do not run this as root; it cleans the caches of the user running it." >&2
  exit 1
fi

# ----------------------------------------------------------------------------
# Look and feel
# ----------------------------------------------------------------------------

C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_MAGENTA="" C_CYAN=""
if [ "$USE_COLOR" = 1 ] && [ -z "${NO_COLOR:-}" ] && [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'; C_MAGENTA=$'\033[35m'; C_CYAN=$'\033[36m'
fi

if [ "$ASCII_ONLY" = 1 ] || [ "${TERM:-}" = "dumb" ]; then
  G_OK="OK"; G_FAIL="X"; G_ARROW=">"; G_DOT="*"
  G_FULL="#"; G_EMPTY="."
  G_TL="+"; G_TR="+"; G_BL="+"; G_BR="+"; G_H="-"; G_V="|"
  FRAMES=("|" "/" "-" "\\")
else
  G_OK="✔"; G_FAIL="✘"; G_ARROW="›"; G_DOT="●"
  G_FULL="█"; G_EMPTY="░"
  G_TL="╭"; G_TR="╮"; G_BL="╰"; G_BR="╯"; G_H="─"; G_V="│"
  FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
fi

IS_TTY=0
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then IS_TTY=1; fi

repeat() { local s="$1" n="$2" out="" i=0; while [ "$i" -lt "$n" ]; do out="$out$s"; i=$((i + 1)); done; printf '%s' "$out"; }

# ----------------------------------------------------------------------------
# Big title: "ANSI Shadow" block letters, one glyph row at a time.
# Override the words with CLEANCODESHIT_TITLE (letters A C D E H I L N O S T only).
# ----------------------------------------------------------------------------

TITLE="${CLEANCODESHIT_TITLE:-CLEAN CODE SHIT}"

# Sets GLY to row $2 (0 to 5) of letter $1; returns 1 for an unknown letter.
glyph() {
  case "$1" in
    C) case "$2" in 0) GLY=' ██████╗';; 1) GLY='██╔════╝';; 2|3) GLY='██║     ';; 4) GLY='╚██████╗';; 5) GLY=' ╚═════╝';; esac ;;
    L) case "$2" in 0) GLY='██╗     ';; 1|2|3) GLY='██║     ';; 4) GLY='███████╗';; 5) GLY='╚══════╝';; esac ;;
    E) case "$2" in 0|4) GLY='███████╗';; 1) GLY='██╔════╝';; 2) GLY='█████╗  ';; 3) GLY='██╔══╝  ';; 5) GLY='╚══════╝';; esac ;;
    A) case "$2" in 0) GLY=' █████╗ ';; 1) GLY='██╔══██╗';; 2) GLY='███████║';; 3) GLY='██╔══██║';; 4) GLY='██║  ██║';; 5) GLY='╚═╝  ╚═╝';; esac ;;
    N) case "$2" in 0) GLY='███╗   ██╗';; 1) GLY='████╗  ██║';; 2) GLY='██╔██╗ ██║';; 3) GLY='██║╚██╗██║';; 4) GLY='██║ ╚████║';; 5) GLY='╚═╝  ╚═══╝';; esac ;;
    O) case "$2" in 0) GLY=' ██████╗ ';; 1) GLY='██╔═══██╗';; 2|3) GLY='██║   ██║';; 4) GLY='╚██████╔╝';; 5) GLY=' ╚═════╝ ';; esac ;;
    D) case "$2" in 0) GLY='██████╗ ';; 1) GLY='██╔══██╗';; 2|3) GLY='██║  ██║';; 4) GLY='██████╔╝';; 5) GLY='╚═════╝ ';; esac ;;
    S) case "$2" in 0|2) GLY='███████╗';; 1) GLY='██╔════╝';; 3) GLY='╚════██║';; 4) GLY='███████║';; 5) GLY='╚══════╝';; esac ;;
    H) case "$2" in 0) GLY='██╗  ██╗';; 1|4) GLY='██║  ██║';; 2) GLY='███████║';; 3) GLY='██╔══██║';; 5) GLY='╚═╝  ╚═╝';; esac ;;
    I) case "$2" in 0) GLY='██╗';; 1|2|3|4) GLY='██║';; 5) GLY='╚═╝';; esac ;;
    T) case "$2" in 0) GLY='████████╗';; 1) GLY='╚══██╔══╝';; 2|3|4) GLY='   ██║   ';; 5) GLY='   ╚═╝   ';; esac ;;
    " ") GLY='   ' ;;
    *) return 1 ;;
  esac
}

# Column width of each glyph (counted here, so the result never depends on the locale).
glyph_cols() {
  case "$1" in
    N) echo 10 ;; O|T) echo 9 ;; I|" ") echo 3 ;; *) echo 8 ;;
  esac
}

# Display width of one word in glyph columns, or -1 if it has an unknown letter.
word_width() {
  local w="$1" k=0 total=0 ch
  while [ "$k" -lt "${#w}" ]; do
    ch="${w:k:1}"
    glyph "$ch" 0 || { echo -1; return; }
    total=$(( total + $(glyph_cols "$ch") ))
    k=$((k + 1))
  done
  echo "$total"
}

# Prints a line of words in block letters, with a top-to-bottom colour gradient.
print_big_line() {
  local text="$1" row k line colors=() c
  if [ -n "$C_RESET" ] && [ "$(tput colors 2>/dev/null || echo 8)" -ge 256 ]; then
    colors=($'\033[38;5;51m' $'\033[38;5;45m' $'\033[38;5;39m' $'\033[38;5;33m' $'\033[38;5;63m' $'\033[38;5;99m')
  else
    colors=("$C_CYAN" "$C_CYAN" "$C_CYAN" "$C_BLUE" "$C_BLUE" "$C_MAGENTA")
  fi
  row=0
  while [ "$row" -lt 6 ]; do
    line=""; k=0
    while [ "$k" -lt "${#text}" ]; do
      glyph "${text:k:1}" "$row"; line="$line$GLY"; k=$((k + 1))
    done
    c="${colors[row]}"
    printf '  %s%s%s%s\n' "$C_BOLD" "$c" "$line" "$C_RESET"
    row=$((row + 1))
  done
}

# Big title when the terminal is wide enough and Unicode-capable, else nothing.
big_title() {
  local cols full w word fits=1
  [ "$IS_TTY" = 1 ] && [ "$ASCII_ONLY" != 1 ] || return 1
  cols=$(tput cols 2>/dev/null || echo 80)
  full=$(word_width "$TITLE")
  [ "$full" -ge 0 ] || return 1
  echo
  if [ $((full + 4)) -le "$cols" ]; then
    print_big_line "$TITLE"
    return 0
  fi
  # Too wide for one line: one word per line, if every word fits.
  for word in $TITLE; do
    w=$(word_width "$word"); [ $((w + 4)) -le "$cols" ] || fits=0
  done
  [ "$fits" = 1 ] || return 1
  for word in $TITLE; do print_big_line "$word"; done
  return 0
}

banner() {
  local title="cleancodeshit $VERSION" sub="free disk space from developer caches and Docker"
  if big_title; then
    sub="cleancodeshit $VERSION  -  $sub"
    local width=$(( ${#sub} + 6 ))
    if [ $((width + 2)) -gt "$(tput cols 2>/dev/null || echo 80)" ]; then
      printf '\n  %s%s%s\n  %s%s%s\n\n' "$C_BOLD$C_CYAN" "cleancodeshit $VERSION" "$C_RESET" "$C_DIM" "free disk space from developer caches and Docker" "$C_RESET"
      return
    fi
    printf '\n  %s%s%s%s%s\n' "$C_CYAN" "$G_TL" "$(repeat "$G_H" $((width - 2)))" "$G_TR" "$C_RESET"
    printf '  %s%s%s  %s%s%s  %s%s%s\n' "$C_CYAN" "$G_V" "$C_RESET" "$C_BOLD$C_CYAN" "$sub" "$C_RESET" "$C_CYAN" "$G_V" "$C_RESET"
    printf '  %s%s%s%s%s\n\n' "$C_CYAN" "$G_BL" "$(repeat "$G_H" $((width - 2)))" "$G_BR" "$C_RESET"
    return
  fi
  local width=$(( ${#sub} + 6 ))
  local pad_t=$(( width - ${#title} - 4 ))
  printf '\n%s%s%s%s%s\n' "$C_CYAN" "$G_TL" "$(repeat "$G_H" $((width - 2)))" "$G_TR" "$C_RESET"
  printf '%s%s%s  %s%s%s%*s%s%s%s\n' "$C_CYAN" "$G_V" "$C_RESET" "$C_BOLD" "$title" "$C_RESET" "$pad_t" "" "$C_CYAN" "$G_V" "$C_RESET"
  printf '%s%s%s  %s%s%s  %s%s%s\n' "$C_CYAN" "$G_V" "$C_RESET" "$C_DIM" "$sub" "$C_RESET" "$C_CYAN" "$G_V" "$C_RESET"
  printf '%s%s%s%s%s\n\n' "$C_CYAN" "$G_BL" "$(repeat "$G_H" $((width - 2)))" "$G_BR" "$C_RESET"
}

section() { printf '\n  %s%s %s%s\n' "$C_BOLD$C_BLUE" "$G_ARROW" "$1" "$C_RESET"; }
info()    { printf '  %s\n' "$*"; }
note()    { printf '  %s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
warn()    { printf '  %s%s%s\n' "$C_YELLOW" "$*" "$C_RESET"; }
fail()    { printf '  %s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2; }

# Bytes to a human size, binary units.
human() {
  awk -v b="$1" 'BEGIN {
    if (b < 0) { print "-"; exit }
    split("B KiB MiB GiB TiB", u, " "); i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    if (i == 1) printf "%d %s", b, u[i]; else printf "%.1f %s", b, u[i]
  }'
}

# A bar of `width` cells, filled in proportion to value/max.
bar() {
  local value="$1" max="$2" width="${3:-14}" filled=0
  if [ "$max" -gt 0 ] && [ "$value" -gt 0 ]; then
    filled=$(awk -v v="$value" -v m="$max" -v w="$width" 'BEGIN { f = int(v * w / m + 0.5); if (f < 1) f = 1; if (f > w) f = w; print f }')
  fi
  printf '%s%s%s%s%s' "$C_CYAN" "$(repeat "$G_FULL" "$filled")" "$C_DIM" "$(repeat "$G_EMPTY" $((width - filled)))" "$C_RESET"
}

risk_badge() {
  case "$1" in
    safe)    printf '%s%-7s%s' "$C_GREEN" "safe" "$C_RESET" ;;
    caution) printf '%s%-7s%s' "$C_YELLOW" "caution" "$C_RESET" ;;
    danger)  printf '%s%-7s%s' "$C_BOLD$C_RED" "danger" "$C_RESET" ;;
  esac
}

# ----------------------------------------------------------------------------
# Environment
# ----------------------------------------------------------------------------

OS=$(uname -s)
case "${XDG_CACHE_HOME:-}" in /*) XDG_CACHE="${XDG_CACHE_HOME%/}" ;; *) XDG_CACHE="$HOME/.cache" ;; esac
case "${XDG_CONFIG_HOME:-}" in /*) XDG_CONFIG="${XDG_CONFIG_HOME%/}" ;; *) XDG_CONFIG="$HOME/.config" ;; esac
case "${XDG_DATA_HOME:-}" in /*) XDG_DATA="${XDG_DATA_HOME%/}" ;; *) XDG_DATA="$HOME/.local/share" ;; esac
case "${XDG_STATE_HOME:-}" in /*) XDG_STATE="$XDG_STATE_HOME" ;; *) XDG_STATE="$HOME/.local/state" ;; esac
case "$OS" in
  Darwin) CACHE_ROOT="$HOME/Library/Caches"; LOG_DIR="$HOME/Library/Logs/cleancodeshit"; EDITOR_ROOT="$HOME/Library/Application Support" ;;
  Linux)  CACHE_ROOT="$XDG_CACHE"; LOG_DIR="${XDG_STATE%/}/cleancodeshit"; EDITOR_ROOT="$XDG_CONFIG" ;;
  *)
    if [ "$MODE" = list ] || [ "$DRY_RUN" = 1 ]; then
      banner
      note "Cache scanning is available on macOS and Linux. This system was skipped."
      [ "$DRY_RUN" = 0 ] || note "Dry run: nothing was changed."
      exit 0
    fi
    fail "Cache cleanup is available on macOS and Linux."
    exit 1 ;;
esac

have() { command -v "$1" >/dev/null 2>&1; }

HOME_PHYSICAL=""
if [ -n "${HOME:-}" ]; then HOME_PHYSICAL=$(CDPATH='' cd -P -- "$HOME" 2>/dev/null && pwd -P); fi

# Resolve the spelling of HOME, then reject traversal and all symlink components.
# Missing descendants are accepted so deleting a vanished cache is idempotent.
home_path() {
  local p="$1" rest part parent="$HOME_PHYSICAL"
  [ -n "$HOME_PHYSICAL" ] && [ "$HOME_PHYSICAL" != / ] || return 1
  while [ "${p%/}" != "$p" ]; do p="${p%/}"; done
  case "$p" in
    "$HOME_PHYSICAL"/*) rest="${p#"$HOME_PHYSICAL"/}" ;;
    "${HOME%/}"/*) rest="${p#"${HOME%/}"/}" ;;
    *) return 1 ;;
  esac
  case "/$rest/" in *'//'*|*'/./'*|*'/../'*|*'/.git/'*) return 1 ;; esac
  while [ -n "$rest" ]; do
    part="${rest%%/*}"
    parent="$parent/$part"
    [ ! -L "$parent" ] || return 1
    [ "$rest" != "$part" ] || break
    rest="${rest#*/}"
  done
  VALID_PATH="$parent"
}

# Directory sizes for user caches come from disk usage, without following links.
dir_bytes() {
  if ! home_path "$1" || [ ! -d "$VALID_PATH" ]; then echo -1; return; fi
  path_bytes "$VALID_PATH" || echo -1
}

path_bytes() {
  local k
  k=$(LC_ALL=C du -skx "$1" 2>/dev/null | awk 'NR == 1 {print $1}') || return 1
  printf '%s\n' "$(( ${k:-0} * 1024 ))"
}

same_file_system() {
  local path="$1" parent="$2" dev device devices mount_point stat_flag
  if [ "$OS" = Linux ] && [ -r /proc/self/mountinfo ]; then
    while read -r _ _ _ _ mount_point _; do
      printf -v mount_point '%b' "$mount_point"
      case "$mount_point" in "$path"|"$path"/*) return 1 ;; esac
    done </proc/self/mountinfo
  fi
  # Detect the installed stat syntax independently of the cache layout.
  if dev=$(stat -c '%d' "$parent" 2>/dev/null); then
    stat_flag=-c
  else
    dev=$(stat -f '%d' "$parent") || return 1
    stat_flag=-f
  fi
  devices=$(find "$path" -xdev -type d -exec stat "$stat_flag" '%d' {} +) || return 1
  [ -n "$devices" ] || return 1
  while IFS= read -r device; do [ "$device" = "$dev" ] || return 1; done <<< "$devices"
}

safe_rm() (
  local p="$1" parent base
  if ! home_path "$p"; then
    printf 'refusing to remove %q: expected a path inside HOME without symlinks\n' "$p" >&2
    return 1
  fi
  p="$VALID_PATH"
  [ -e "$p" ] || return 0
  parent="${p%/*}"; base="${p##*/}"
  if ! CDPATH='' cd -P -- "$parent" || [ "$(pwd -P)" != "$parent" ] || [ -L "./$base" ]; then
    printf 'refusing to remove %q: path changed\n' "$p" >&2
    return 1
  fi
  if [ -d "./$base" ] && ! same_file_system "$p" "$parent"; then
    printf 'refusing to remove %q: mounted or unreadable directory\n' "$p" >&2
    return 1
  fi
  printf 'removing %q\n' "$p"
  rm -rf -- "./$base"
)

run_in_home_cache() {
  local cache="$1"
  shift
  home_path "$cache" && [ -d "$VALID_PATH" ] || { fail "Cache path is unavailable or outside HOME."; return 1; }
  same_file_system "$VALID_PATH" "${VALID_PATH%/*}" || { fail "Cache path is mounted or unreadable."; return 1; }
  "$@"
}

disk_free_bytes() { df -k "$HOME" 2>/dev/null | awk 'NR == 2 { printf "%.0f", $4 * 1024 }'; }
disk_total_bytes() { df -k "$HOME" 2>/dev/null | awk 'NR == 2 { printf "%.0f", $2 * 1024 }'; }

# Docker reports sizes in SI units ("9.413GB").
si_bytes() {
  awk -v s="$1" 'BEGIN {
    n = s + 0; u = s; gsub(/[0-9.]/, "", u); m = 1
    if (u == "kB" || u == "KB") m = 1e3; else if (u == "MB") m = 1e6
    else if (u == "GB") m = 1e9; else if (u == "TB") m = 1e12
    printf "%.0f", n * m
  }'
}

DOCKER_OK=0
DOCKER_WHY=""
DOCKER_PATTERNS=()
MATCHED_IMAGES=()
DOCKER_ARGS=()
DOCKER_ENDPOINT=""
DOCKER_CONTEXT_NAME=""

select_docker_endpoint() {
  if [ -z "${DOCKER_CONTEXT:-}" ] && [ -n "${DOCKER_HOST:-}" ]; then
    DOCKER_ARGS=(--host "$DOCKER_HOST")
    DOCKER_CONTEXT_NAME=""
    return 0
  fi
  DOCKER_CONTEXT_NAME=$(docker context show 2>/dev/null) || return 1
  [ -n "$DOCKER_CONTEXT_NAME" ] || return 1
  DOCKER_ARGS=(--context "$DOCKER_CONTEXT_NAME")
  DOCKER_ENDPOINT=$(docker_context_endpoint) && [ -n "$DOCKER_ENDPOINT" ]
}

docker_context_endpoint() {
  docker context inspect --format '{{(index .Endpoints "docker").Host}}' "$DOCKER_CONTEXT_NAME" 2>/dev/null
}

docker_cmd() { docker "${DOCKER_ARGS[@]}" "$@"; }

docker_endpoint_unchanged() {
  [ -z "$DOCKER_CONTEXT_NAME" ] || [ "$(docker_context_endpoint)" = "$DOCKER_ENDPOINT" ]
}

load_docker_patterns() {
  local config="${XDG_CONFIG%/}/cleancodeshit/config" value="" line pattern seen=0
  DOCKER_PATTERNS=()
  if [ "${CLEANCODESHIT_DOCKER_IMAGES+x}" = x ]; then
    value="$CLEANCODESHIT_DOCKER_IMAGES"
  elif [ -f "$config" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%$'\r'}"
      line="${line#"${line%%[![:blank:]]*}"}"
      line="${line%"${line##*[![:blank:]]}"}"
      case "$line" in
        ''|\#*) ;;
        docker_images=*)
          [ "$seen" = 0 ] || { warn "Ignoring Docker image patterns: repeated docker_images key."; return; }
          value="${line#*=}"; seen=1 ;;
        *) warn "Ignoring Docker image patterns: invalid configuration line."; return ;;
      esac
    done <"$config"
  fi
  value="${value//$'\n'/ }"
  IFS=$' ,\t' read -r -a DOCKER_PATTERNS <<< "$value"
  for pattern in "${DOCKER_PATTERNS[@]}"; do
    if [[ ! "$pattern" =~ ^[[:alnum:]_./:*?-]+$ ]]; then
      warn "Ignoring Docker image patterns: expected repository or repository:tag globs."
      DOCKER_PATTERNS=()
      return
    fi
  done
}

load_matching_images() {
  local repo tag image_id size pattern ref ids=()
  MATCHED_IMAGES=(); D_MATCHED=0
  [ "${#DOCKER_PATTERNS[@]}" -gt 0 ] || return 0
  while IFS='|' read -r repo tag image_id size; do
    [[ "$repo" =~ ^[[:alnum:]_][[:alnum:]_./:-]*$ && "$tag" =~ ^[[:alnum:]_][[:alnum:]_.-]*$ ]] || continue
    ref="$repo:$tag"
    for pattern in "${DOCKER_PATTERNS[@]}"; do
      # The configuration supplies an actual glob.
      # shellcheck disable=SC2053
      if [[ "$repo" == $pattern || "$ref" == $pattern ]]; then
        contains "$ref" "${MATCHED_IMAGES[@]}" || MATCHED_IMAGES[${#MATCHED_IMAGES[@]}]="$ref"
        if ! contains "$image_id" "${ids[@]}"; then
          ids[${#ids[@]}]="$image_id"
          D_MATCHED=$((D_MATCHED + $(si_bytes "$size")))
        fi
        break
      fi
    done
  done < <(docker_cmd image ls --format '{{.Repository}}|{{.Tag}}|{{.ID}}|{{.Size}}' 2>/dev/null)
}

load_docker() {
  D_IMG=0; D_CTR=0; D_CTR_ALL=0; D_VOL=0; D_BLD=0
  D_CTR_TOTAL=0; D_CTR_RUNNING=0; D_NET=0; D_VOL_N=0
  MATCHED_IMAGES=(); D_MATCHED=0
  DOCKER_OK=0
  if ! have docker; then DOCKER_WHY="docker is not installed"; return; fi
  if [ "${#DOCKER_ARGS[@]}" -eq 0 ] && ! select_docker_endpoint; then
    DOCKER_WHY="could not identify the Docker endpoint"; return
  fi
  if ! docker_endpoint_unchanged; then DOCKER_WHY="the selected Docker endpoint changed"; return; fi
  if ! docker_cmd version --format '{{.Server.Version}}' >/dev/null 2>&1; then
    DOCKER_WHY="Docker is not running (start OrbStack or Docker Desktop)"; return
  fi
  DOCKER_OK=1
  local t size recl r
  while IFS='|' read -r t size recl; do
    r="${recl%% *}"
    case "$t" in
      Images)          D_IMG=$(si_bytes "$r") ;;
      Containers)      D_CTR=$(si_bytes "$r"); D_CTR_ALL=$(si_bytes "$size") ;;
      "Local Volumes") D_VOL=$(si_bytes "$r") ;;
      "Build Cache")   D_BLD=$(si_bytes "$r") ;;
    esac
  done < <(docker_cmd system df --format '{{.Type}}|{{.Size}}|{{.Reclaimable}}' 2>/dev/null)
  D_CTR_TOTAL=$(docker_cmd ps -aq 2>/dev/null | wc -l | tr -d ' ')
  D_CTR_RUNNING=$(docker_cmd ps -q 2>/dev/null | wc -l | tr -d ' ')
  D_NET=$(docker_cmd network ls --filter type=custom -q 2>/dev/null | wc -l | tr -d ' ')
  D_VOL_N=$(docker_cmd volume ls -q --filter dangling=true 2>/dev/null | wc -l | tr -d ' ')
  load_matching_images
}

resolve_paths() {
  local path
  NPM_CACHE="${npm_config_cache:-${NPM_CONFIG_CACHE:-}}"
  if [ -z "$NPM_CACHE" ] && have npm; then
    NPM_CACHE=$(npm --logs-max=0 --update-notifier=false --timing=false config get cache 2>/dev/null) || NPM_CACHE=""
  fi
  NPM_CACHE="${NPM_CACHE:-$HOME/.npm}"
  NPM_CACHE="${NPM_CACHE%/}"
  if [ "$OS" = Darwin ]; then
    YARN_CACHE="${YARN_CACHE_FOLDER:-$CACHE_ROOT/Yarn}"
    PNPM_ROOT="${PNPM_HOME:-$HOME/Library/pnpm}"
  else
    YARN_CACHE="${YARN_CACHE_FOLDER:-$CACHE_ROOT/yarn}"
    PNPM_ROOT="${PNPM_HOME:-$XDG_DATA/pnpm}"
  fi
  PNPM_ROOT="${PNPM_ROOT%/}/store"
  PNPM_CACHE=""
  for path in "$PNPM_ROOT"/v[0-9]*; do
    if home_path "$path" && [ -d "$VALID_PATH" ]; then PNPM_CACHE="$path"; fi
  done
  UV_CACHE="${UV_CACHE_DIR:-$XDG_CACHE/uv}"
  BREW_CACHE="${HOMEBREW_CACHE:-$CACHE_ROOT/Homebrew}"
  GO_CACHE="${GOCACHE:-$CACHE_ROOT/go-build}"
  PIP_CACHE="${PIP_CACHE_DIR:-$CACHE_ROOT/pip}"
  PRECOMMIT_CACHE="${PRE_COMMIT_HOME:-$XDG_CACHE/pre-commit}"
  GRADLE_CACHE="${GRADLE_USER_HOME:-$HOME/.gradle}"
  GRADLE_CACHE="${GRADLE_CACHE%/}/caches"
}

# ----------------------------------------------------------------------------
# Items
#
# Each item has an id, a group, a risk, a label and the action it runs.
# probe_<id> sets PROBE_BYTES (and optionally PROBE_NOTE) and returns 0 when the
# item exists. clean_<id> does the cleaning; its output goes to the log.
# Docker items are listed in the order they must run: containers before
# images (an image is only "unused" once its containers are gone), volumes last.
# ----------------------------------------------------------------------------

N=0
add() { IDS[N]="$1"; GROUP[N]="$2"; RISK[N]="$3"; LABEL[N]="$4"; ACTION[N]="$5"; N=$((N + 1)); }

add npm        "Package managers"      safe    "npm cache"                              "npm cache clean --force"
add npx        "Package managers"      safe    "npx downloaded tools"                   "remove the npx folder in the npm cache"
add pnpm       "Package managers"      safe    "pnpm store (packages no project uses)"  "pnpm store prune"
