resolve_agent_paths() {
  local config="${CLAUDE_CONFIG_DIR:-$HOME/.claude}" hf_home="${HF_HOME:-$XDG_CACHE/huggingface}"
  CLAUDE_HOME="${config%/}"
  CLAUDE_DEBUG="$CLAUDE_HOME/debug"
  CODEX_ROOT="${CODEX_HOME:-$HOME/.codex}"; CODEX_ROOT="${CODEX_ROOT%/}"
  GEMINI_ROOT="${GEMINI_CLI_HOME:-$HOME}"; GEMINI_ROOT="${GEMINI_ROOT%/}/.gemini"
  COPILOT_ROOT="${COPILOT_HOME:-$HOME/.copilot}"; COPILOT_ROOT="${COPILOT_ROOT%/}"
  OPENCODE_LOG="${XDG_DATA%/}/opencode/log"
  VSCODE_ROOT="${VSCODE_APPDATA:-$EDITOR_ROOT}"; VSCODE_ROOT="${VSCODE_ROOT%/}/Code"
  if [ -n "${VSCODE_PORTABLE:-}" ]; then VSCODE_ROOT="${VSCODE_PORTABLE%/}/user-data"; fi
  CURSOR_ROOT="${EDITOR_ROOT%/}/Cursor"
  PUPPETEER_ROOT="${PUPPETEER_CACHE_DIR:-$HOME/.cache/puppeteer}"; PUPPETEER_ROOT="${PUPPETEER_ROOT%/}"
  HF_ROOT="${HF_HUB_CACHE:-${HUGGINGFACE_HUB_CACHE:-${hf_home%/}/hub}}"; HF_ROOT="${HF_ROOT%/}"
  OLLAMA_ROOT="${OLLAMA_MODELS:-$HOME/.ollama/models}"; OLLAMA_ROOT="${OLLAMA_ROOT%/}"
  TORCH_ROOT="${TORCH_HOME:-$XDG_CACHE/torch}"; TORCH_ROOT="${TORCH_ROOT%/}/hub"
  LM_ROOT="$HOME/.lmstudio/models"
}

probe_target() {
  local kind="$1" path="$2"
  home_path "$path" || return 1
  path="$VALID_PATH"
  case "$kind" in
    dir) [ -d "$path" ] || return 1 ;;
    file) [ -f "$path" ] || return 1 ;;
  esac
  TARGET_BYTES=$(path_bytes "$path") || return 1
  PROBE_BYTES=$((PROBE_BYTES + TARGET_BYTES))
  PROBE_TARGETS[${#PROBE_TARGETS[@]}]="$path"
  PROBE_KINDS[${#PROBE_KINDS[@]}]="$kind"
}

probe_dirs() {
  local path
  for path in "$@"; do probe_target dir "$path" || continue; done
  [ "${#PROBE_TARGETS[@]}" -gt 0 ]
}

probe_agent_files() {
  local root="$1" depth="$2" name="$3" file
  home_path "$root" && [ -d "$VALID_PATH" ] || return 0
  while IFS= read -r -d '' file; do probe_target file "$file" || continue; done < <(
    find "$VALID_PATH" -mindepth "$depth" -maxdepth "$depth" -name .git -prune -o -type f -name "$name" -print0 2>/dev/null
  )
}

probe_claude_debug() {
  local log name candidates=()
  if [ -n "${CLAUDE_CODE_DEBUG_LOGS_DIR:-}" ]; then
    candidates=("$CLAUDE_CODE_DEBUG_LOGS_DIR")
  else
    home_path "$CLAUDE_DEBUG" && [ -d "$VALID_PATH" ] || return 1
    candidates=("$VALID_PATH"/*.txt)
  fi
  for log in "${candidates[@]}"; do
    name="${log##*/}"
    if [[ ! "$name" =~ ^[a-fA-F0-9]{8}(-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12}\.txt$ &&
          ! "$name" =~ ^claude-debug[-._a-zA-Z0-9]*\.(log|txt)$ ]]; then continue; fi
    probe_target file "$log" || continue
  done
  [ "${#PROBE_TARGETS[@]}" -gt 0 ]
}
probe_claude_history() {
  probe_agent_files "$CLAUDE_HOME/projects" 2 '*.jsonl'
  [ "${#PROBE_TARGETS[@]}" -gt 0 ]
}
probe_codex_logs()     { probe_dirs "$CODEX_ROOT/log"; }
probe_codex_history() {
  local year month day
  # Restrict rollouts to the recorder's dated layout.
  if home_path "$CODEX_ROOT/sessions" && [ -d "$VALID_PATH" ]; then
  for year in "$VALID_PATH"/[0-9][0-9][0-9][0-9]; do
    home_path "$year" && [ -d "$VALID_PATH" ] || continue
    for month in "$year"/[0-9][0-9]; do
      home_path "$month" && [ -d "$VALID_PATH" ] || continue
      for day in "$month"/[0-9][0-9]; do probe_agent_files "$day" 1 'rollout-*.jsonl'; done
    done
  done
  fi
  probe_agent_files "$CODEX_ROOT/archived_sessions" 1 'rollout-*.jsonl'
  probe_target file "$CODEX_ROOT/history.jsonl" || :
  [ "${#PROBE_TARGETS[@]}" -gt 0 ]
}
probe_gemini_history() {
  local project
  if home_path "$GEMINI_ROOT/tmp" && [ -d "$VALID_PATH" ]; then
    for project in "$VALID_PATH"/*; do
      home_path "$project" && [ -d "$VALID_PATH" ] || continue
      probe_agent_files "$project/chats" 1 'session-*.json'
      probe_agent_files "$project/chats" 1 'session-*.jsonl'
    done
  fi
  [ "${#PROBE_TARGETS[@]}" -gt 0 ]
}
probe_copilot_logs()   { probe_dirs "$COPILOT_ROOT/logs"; }
probe_opencode_logs()  { probe_dirs "$OPENCODE_LOG"; }

editor_closed() {
  local app="$1" processes
  processes=$(ps -ax -o comm= 2>/dev/null) || return 1
  ! printf '%s\n' "$processes" | awk -v app="$app" '
    { sub(/^.*\//, ""); sub(/^[[:space:]]+/, ""); name = tolower($0) }
    app == "VS Code" && (name == "code" || name == "electron" || name == "visual studio code" || name ~ /^code helper/) { running = 1 }
    app == "Cursor" && (name == "cursor" || name ~ /^cursor helper/) { running = 1 }
    app == "Windsurf and Devin Desktop" && (name == "windsurf" || name == "devin" || name == "devin-desktop" || name ~ /^(windsurf|devin) helper/) { running = 1 }
    END { exit !running }'
}

probe_editor() {
  local name="$1"
  shift
  probe_dirs "$@" || return 1
  if ! editor_closed "$name"; then
    SCAN_NOTES[${#SCAN_NOTES[@]}]="$name skipped: close the app to scan its logs and caches, or check that process status is available."
    return 1
  fi
}

probe_vscode() {
  probe_editor 'VS Code' "$VSCODE_ROOT/logs" "$VSCODE_ROOT/CachedData" "$VSCODE_ROOT/Cache" "$VSCODE_ROOT/CachedExtensionVSIXs"
}
probe_cursor() {
  [ "$OS" = Darwin ] || return 1
  probe_editor Cursor "$CURSOR_ROOT/logs" "$CURSOR_ROOT/CachedData" "$CURSOR_ROOT/Cache" "$CURSOR_ROOT/Code Cache" "$CURSOR_ROOT/GPUCache" "$CURSOR_ROOT/CachedExtensionVSIXs"
}
probe_windsurf() {
  local root="${EDITOR_ROOT%/}"
  probe_editor 'Windsurf and Devin Desktop' "$root/Windsurf/logs" "$root/Windsurf/crashpad" "$root/Devin/logs" "$root/Devin/crashpad"
}
probe_puppeteer() {
  probe_dirs "$PUPPETEER_ROOT/chrome" "$PUPPETEER_ROOT/chrome-headless-shell" "$PUPPETEER_ROOT/chromium" "$PUPPETEER_ROOT/firefox"
}

model_detail() {
  local name="$1" detail
  printf -v detail '%q  %s' "$name" "$(human "$TARGET_BYTES")"
  PROBE_DETAILS[${#PROBE_DETAILS[@]}]="$detail"
}

probe_hf_hub() {
  local repo
  home_path "$HF_ROOT" && [ -d "$VALID_PATH" ] || return 1
  for repo in "$VALID_PATH"/models--?*; do
    home_path "$repo/snapshots" && [ -d "$VALID_PATH" ] || continue
    if probe_target dir "$repo"; then model_detail "${repo##*/}"; fi
  done
  [ "${#PROBE_TARGETS[@]}" -gt 0 ]
}

probe_ollama() {
  local name id number unit row
  probe_dirs "$OLLAMA_ROOT/blobs" "$OLLAMA_ROOT/manifests" "$OLLAMA_ROOT/manifests-v2" || return 1
  PROBE_NOTE="only the in-home model store; the CLI list describes the local server"
  if have ollama && [ -z "${OLLAMA_HOST:-}" ]; then
    while read -r name id number unit _; do
      [[ "$id" =~ ^[a-fA-F0-9]+$ && "$number" =~ ^[0-9]+(\.[0-9]+)?$ ]] || continue
      printf -v row '%q  %s %s' "$name" "$number" "$unit"
      PROBE_DETAILS[${#PROBE_DETAILS[@]}]="$row"
    done < <(ollama list 2>/dev/null)
  fi
}

probe_torch_hub() {
  local path
  probe_dirs "$TORCH_ROOT" || return 1
  for path in "$TORCH_ROOT"/checkpoints/*; do
    home_path "$path" && [ -f "$VALID_PATH" ] || continue
    TARGET_BYTES=$(path_bytes "$VALID_PATH") || continue
    model_detail "${path##*/}"
  done
}

probe_lm_studio() {
  local path
  home_path "$LM_ROOT" && [ -d "$VALID_PATH" ] || return 1
  while IFS= read -r -d '' path; do
    if probe_target file "$path"; then model_detail "${path#"$LM_ROOT"/}"; fi
  done < <(find "$VALID_PATH" -mindepth 3 -maxdepth 3 -type f -name '*.gguf' -print0 2>/dev/null)
  [ "${#PROBE_TARGETS[@]}" -gt 0 ]
}

clean_targets() {
  local i path status=0
  for i in "${!TARGET_ITEMS[@]}"; do
    [ "${TARGET_ITEMS[i]}" = "$ITEM_INDEX" ] || continue
    path="${TARGET_PATHS[i]}"
    if ! home_path "$path"; then
      printf 'refusing to remove %q: path changed\n' "$path" >&2
      status=1
      continue
    fi
    [ -e "$VALID_PATH" ] || continue
    if [ "${IDS[ITEM_INDEX]}" = stale ] && ! stale_is_eligible "$path"; then
      printf 'skipping changed project folder %q\n' "$path" >&2
      status=1
      continue
    fi
    case "${TARGET_KINDS[i]}" in
      dir) [ -d "$VALID_PATH" ] || { status=1; continue; } ;;
      file) [ -f "$VALID_PATH" ] || { status=1; continue; } ;;
    esac
    safe_rm "$path" || status=1
  done
  return "$status"
}

