clean_dk_all() {
  local id output running=() all=()
  output=$(docker_cmd ps -aq) || return
  while IFS= read -r id; do [ -z "$id" ] || all[${#all[@]}]="$id"; done <<< "$output"
  output=$(docker_cmd ps -q) || return
  while IFS= read -r id; do
    if [ -n "$id" ] && contains "$id" "${all[@]}"; then running[${#running[@]}]="$id"; fi
  done <<< "$output"
  [ "${#running[@]}" -eq 0 ] || docker_cmd stop -- "${running[@]}" || return
  [ "${#all[@]}" -eq 0 ] || docker_cmd rm -- "${all[@]}"
}
clean_dk_stopped() { docker_cmd container prune -f; }
clean_dk_custom()  {
  local ref rc=0
  for ref in "${MATCHED_IMAGES[@]}"; do docker_cmd image rm -- "$ref" || rc=1; done
  return "$rc"
}
clean_dk_images()  { docker_cmd image prune -af; }
clean_dk_build()   { docker_cmd builder prune -af; }
clean_dk_net()     { docker_cmd network prune -f; }
clean_dk_volumes() { docker_cmd volume prune -af 2>/dev/null || docker_cmd volume prune -f; }

