probe_dir() { PROBE_BYTES=$(dir_bytes "$1"); [ "$PROBE_BYTES" -ge 0 ]; }

probe_npm()        { have npm || return 1; probe_dir "$NPM_CACHE/_cacache"; }
probe_npx()        { probe_dir "$NPM_CACHE/_npx"; }
probe_pnpm()       { have pnpm && probe_dir "$PNPM_CACHE" || return 1; PROBE_NOTE="only packages no project uses are removed, so the saving can be small"; }
probe_yarn()       {
  home_path "$YARN_CACHE" && [ -d "$VALID_PATH" ] || return 1
  probe_dirs "$VALID_PATH"/v[0-9]*
}
probe_bun()        { probe_dir "$HOME/.bun/install/cache"; }
probe_uv()         { have uv && probe_dir "$UV_CACHE" || return 1; PROBE_NOTE="removes unused entries only; the size shown is the whole cache"; }
probe_pip()        { probe_dirs "$PIP_CACHE/http" "$PIP_CACHE/http-v2" "$PIP_CACHE/wheels" "$PIP_CACHE/selfcheck"; }
probe_brew()       { have brew && probe_dir "$BREW_CACHE" || return 1; PROBE_NOTE="also removes old versions of installed formulae"; }
probe_xcode()      { [ "$OS" = Darwin ] && probe_dir "$HOME/Library/Developer/Xcode/DerivedData"; }
probe_playwright() { probe_dir "$CACHE_ROOT/ms-playwright" || return 1; PROBE_NOTE="browsers re-download on the next playwright install"; }
probe_electron()   {
  local a b; a=$(dir_bytes "$CACHE_ROOT/electron"); b=$(dir_bytes "$CACHE_ROOT/electron-builder")
  [ "$a" -ge 0 ] || [ "$b" -ge 0 ] || return 1
  [ "$a" -ge 0 ] || a=0; [ "$b" -ge 0 ] || b=0
  PROBE_BYTES=$((a + b))
}
probe_nodegyp()    { probe_dir "$CACHE_ROOT/node-gyp"; }
probe_typescript() { probe_dir "$CACHE_ROOT/typescript"; }
probe_go()         { have go && probe_dir "$GO_CACHE"; }
probe_cargo()      { probe_dir "$HOME/.cargo/registry/cache"; }
probe_cocoapods()  { [ "$OS" = Darwin ] && probe_dir "$CACHE_ROOT/CocoaPods"; }
probe_gradle()     { probe_dir "$GRADLE_CACHE" || return 1; PROBE_NOTE="dependencies re-download on the next build"; }
probe_precommit()  {
  local cache target marker
  home_path "$PRECOMMIT_CACHE" && [ -f "$VALID_PATH/db.db" ] || return 1
  cache="$VALID_PATH"
  [ -f "$cache/README" ] && [ ! -L "$cache/README" ] || return 1
  IFS= read -r marker <"$cache/README" || return 1
  [ "$marker" = 'This directory is maintained by the pre-commit project.' ] || return 1
  probe_target file "$cache/db.db" || return 1
  for target in "$cache"/repo????????; do probe_target dir "$target" || continue; done
}

probe_dk_all()     {
  [ "$DOCKER_OK" = 1 ] && [ "$D_CTR_TOTAL" -gt 0 ] || return 1
  PROBE_BYTES=$D_CTR_ALL
  PROBE_NOTE="stops $D_CTR_RUNNING running container(s) and removes all $D_CTR_TOTAL; their data is lost"
}
probe_dk_stopped() {
  [ "$DOCKER_OK" = 1 ] && [ $((D_CTR_TOTAL - D_CTR_RUNNING)) -gt 0 ] || return 1
  PROBE_BYTES=$D_CTR; PROBE_NOTE="$((D_CTR_TOTAL - D_CTR_RUNNING)) stopped; their writable layers are lost"
}
probe_dk_custom()  {
  [ "${#MATCHED_IMAGES[@]}" -gt 0 ] || return 1
  PROBE_BYTES=$D_MATCHED
  PROBE_NOTE="${#MATCHED_IMAGES[@]} matching tag(s); shared layers can reduce savings"
  PROBE_DETAILS=("${MATCHED_IMAGES[@]}")
}
probe_dk_images()  { [ "$DOCKER_OK" = 1 ] && [ "$D_IMG" -gt 0 ] || return 1; PROBE_BYTES=$D_IMG; PROBE_NOTE="local-only images can be lost; more frees up once containers are removed"; }
probe_dk_build()   { [ "$DOCKER_OK" = 1 ] && [ "$D_BLD" -gt 0 ] || return 1; PROBE_BYTES=$D_BLD; }
probe_dk_net()     { [ "$DOCKER_OK" = 1 ] && [ "$D_NET" -gt 0 ] || return 1; PROBE_BYTES=-1; PROBE_NOTE="$D_NET custom network(s); only unused ones go"; }
probe_dk_volumes() {
  [ "$DOCKER_OK" = 1 ] && { [ "$D_VOL" -gt 0 ] || [ "$D_VOL_N" -gt 0 ]; } || return 1
  PROBE_BYTES=$D_VOL; PROBE_NOTE="named and anonymous volumes no container uses; databases live here"
}

clean_npm()        { run_in_home_cache "$NPM_CACHE/_cacache" npm --cache "$NPM_CACHE" cache clean --force; }
clean_npx()        { safe_rm "$NPM_CACHE/_npx"; }
clean_pnpm() {
  local entry store
  home_path "$PNPM_ROOT" || return 1
  for entry in "$VALID_PATH"/v[0-9]*; do [ ! -L "$entry" ] || return 1; done
  store=$(pnpm --store-dir "$PNPM_ROOT" store path) || return 1
  run_in_home_cache "$store" pnpm --store-dir "$PNPM_ROOT" store prune
}
