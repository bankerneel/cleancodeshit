  node_modules
  .venv
  venv
  target
  .next
  dist
  build
  .turbo
  .parcel-cache
)

# A directory is treated as a project when it carries one of these files.
# Common lockfiles are included so that lockfile-only checkouts still count.
STALE_MANIFEST_NAMES=(
  package.json
  package-lock.json
  npm-shrinkwrap.json
  yarn.lock
  pnpm-lock.yaml
  bun.lockb
  deno.json
  deno.jsonc
  Cargo.toml
  Cargo.lock
  go.mod
  go.sum
  pyproject.toml
  setup.py
  setup.cfg
  Pipfile
  Pipfile.lock
  poetry.lock
  requirements.txt
  Gemfile
  Gemfile.lock
  pom.xml
  build.gradle
  build.gradle.kts
  settings.gradle
  composer.json
  composer.lock
  mix.exs
  mix.lock
  CMakeLists.txt
  Makefile
  makefile
  GNUmakefile
  meson.build
  build.zig
  pubspec.yaml
  Package.swift
  Podfile
)

STALE_FIND_NAME_ARGS=()

# Build the find sub-expression matching any artifact name.
stale_build_find_name_args() {
  STALE_FIND_NAME_ARGS=()
  local n
  for n in "${STALE_ARTIFACT_NAMES[@]}"; do
    if [ ${#STALE_FIND_NAME_ARGS[@]} -eq 0 ]; then
      STALE_FIND_NAME_ARGS+=( -name "$n" )
    else
      STALE_FIND_NAME_ARGS+=( -o -name "$n" )
    fi
  done
}

stale_build_find_name_args

# Report an invalid input through the lead's fail helper, then fail the call.
stale_invalid() {
  fail "stale-project: $1"
  return 1
}

# Resolve INPUT to a physical path one component at a time. Every component
# is checked with -L before it is accepted, so a symlink anywhere in the path
# is rejected instead of being silently resolved. Dot components are dropped,
# dot-dot components pop the accumulated path. The result is in
# STALE_NORMALIZED; "/" is used when the stack is empty.
stale_normalize_physical() {
  local input=$1 rest comp out=""
  case $input in
    /*) rest=$input ;;
    *) rest="$PWD/$input" ;;
  esac
  while [ -n "$rest" ]; do
    case $rest in
      */*) comp=${rest%%/*}; rest=${rest#*/} ;;
      *)   comp=$rest; rest="" ;;
    esac
    case $comp in
      ''|.) continue ;;
      ..)
        out=${out%/*}
        ;;
      *)
        if [ -z "$out" ]; then
          out="/$comp"
        else
          out="$out/$comp"
        fi
        if [ -L "$out" ]; then
          STALE_INVALID_REASON="scan root traverses symlink: $out"
          return 1
        fi
        ;;
    esac
  done
  [ -z "$out" ] && out="/"
  STALE_NORMALIZED=$out
  return 0
}

# True when any path component is exactly .git. Only the name is inspected;
# the contents of .git are never read.
stale_path_has_git_component() {
  local p=$1 rest comp
  rest=${p#/}
  while [ -n "$rest" ]; do
    case $rest in
      */*) comp=${rest%%/*}; rest=${rest#*/} ;;
      *)   comp=$rest; rest="" ;;
    esac
    [ "$comp" = ".git" ] && return 0
  done
  return 1
}

# True when any component strictly below BASE is a symlink.
stale_path_has_symlink_below() {
  local p=$1 base=$2 cur rest comp
  case $p in
    "$base"/*) rest=${p#"$base"/} ;;
    *) return 1 ;;
  esac
  cur=$base
  while [ -n "$rest" ]; do
    case $rest in
      */*) comp=${rest%%/*}; rest=${rest#*/} ;;
      *)   comp=$rest; rest="" ;;
    esac
    [ -z "$comp" ] && continue
    cur="$cur/$comp"
    [ -L "$cur" ] && return 0
  done
  return 1
}

# Validate STALE_ROOT and STALE_DAYS. On success STALE_ROOT_PHYSICAL holds the
# normalized root. On failure fail MESSAGE is called and 1 is returned.
validate_stale_root() {
  STALE_ROOT_PHYSICAL=""
  STALE_INVALID_REASON=""

  if [ -z "${HOME_PHYSICAL:-}" ]; then
    stale_invalid "HOME_PHYSICAL is required"
    return 1
  fi

  case ${STALE_DAYS-} in
    ''|*[!0-9]*)
      stale_invalid "STALE_DAYS must be an integer from 0 to 365000"
      return 1
      ;;
  esac
  if [ ${#STALE_DAYS} -gt 6 ]; then
    stale_invalid "STALE_DAYS must be an integer from 0 to 365000"
    return 1
  fi
  STALE_DAYS=$(( 10#$STALE_DAYS ))
  if [ "$STALE_DAYS" -gt 365000 ]; then
    stale_invalid "STALE_DAYS must be an integer from 0 to 365000"
    return 1
  fi

  if [ -z "${STALE_ROOT:-}" ]; then
    stale_invalid "STALE_ROOT is required"
    return 1
  fi
  if ! stale_normalize_physical "$STALE_ROOT"; then
    stale_invalid "$STALE_INVALID_REASON"
    return 1
  fi

  local root=$STALE_NORMALIZED home=$HOME_PHYSICAL ancestor
  while [ "$home" != "/" ] && [ "${home%/}" != "$home" ]; do
    home=${home%/}
  done

  if [ "$root" = "/" ]; then
    stale_invalid "STALE_ROOT must not be /"
    return 1
  fi
  if [ "$root" = "$home" ]; then
    stale_invalid "STALE_ROOT must not be HOME_PHYSICAL"
    return 1
  fi
  if stale_path_has_git_component "$root"; then
    stale_invalid "STALE_ROOT must not be inside .git"
    return 1
  fi
  case $root in
    "$home"/*) ;;
    *)
      stale_invalid "STALE_ROOT must be strictly inside HOME_PHYSICAL"
      return 1
      ;;
  esac
  if [ ! -d "$root" ] || [ -L "$root" ]; then
    stale_invalid "STALE_ROOT is not a directory: $root"
    return 1
  fi
  # An enclosing index outside the scan root could track the proposed artifacts.
  ancestor="${root%/*}"
  while [ "$ancestor" = "$home" ] || [[ "$ancestor" == "$home"/* ]]; do
    if stale_has_git_marker "$ancestor"; then
      stale_invalid "choose the Git repository root or a containing directory for --in"
      return 1
    fi
    ancestor="${ancestor%/*}"
  done

  STALE_ROOT_PHYSICAL=$root
  STALE_ROOT=$root
  return 0
}

stale_name_is_artifact() {
  local n=$1 a
  for a in "${STALE_ARTIFACT_NAMES[@]}"; do
    [ "$n" = "$a" ] && return 0
  done
  return 1
}

# Project context helpers. Existence of .git is metadata only, never read.
stale_has_manifest() {
  local d=$1 f p
  for f in "${STALE_MANIFEST_NAMES[@]}"; do
    p="$d/$f"
    if [ -f "$p" ] && [ ! -L "$p" ]; then
      return 0
    fi
  done
  return 1
}

stale_has_git_marker() {
  local p=$1/.git
  if [ -e "$p" ] || [ -L "$p" ]; then
    return 0
  fi
  return 1
}

stale_has_context() {
  stale_has_manifest "$1" || stale_has_git_marker "$1"
}

stale_git() (
  local project="$1"
  shift
  unset GIT_COMMON_DIR GIT_INDEX_FILE GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS
  GIT_OPTIONAL_LOCKS=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    git -c core.fsmonitor=false -c core.excludesfile=/dev/null \
    --git-dir="$project/.git" --work-tree="$project" -C "$project" "$@"
)

stale_safe_artifact() {
  local path="$1" project="$2" repo="$2" relative tracked
  while ! stale_has_git_marker "$repo" && [ "$repo" != "$STALE_ROOT_PHYSICAL" ]; do repo="${repo%/*}"; done
  relative="./${path#"$repo"/}"
  [ ! -L "$repo/.git" ] && [ ! -f "$repo/.git" ] || return 1
  if [ -f "$repo/.git/index" ]; then
    [ ! -L "$repo/.git/index" ] && have git || return 1
    if tracked=$(stale_git "$repo" ls-files -- "$relative" 2>/dev/null); then
      [ -z "$tracked" ] || return 1
      if stale_git "$repo" check-ignore -q -- "$relative" 2>/dev/null; then
        return 0
      fi
    else
      return 1
    fi
  fi
  case "${path##*/}" in
    build)
      { [ -f "$path/CMakeCache.txt" ] && [ -d "$path/CMakeFiles" ]; } ||
        { { [ -f "$project/build.gradle" ] || [ -f "$project/build.gradle.kts" ]; } && [ -d "$path/generated" ]; } ;;
    target)
      { [ -f "$project/Cargo.toml" ] && [ -f "$path/CACHEDIR.TAG" ]; } ||
        { [ -f "$project/pom.xml" ] && [ -d "$path/maven-status" ]; } ;;
    dist) return 1 ;;
    venv|.venv) [ -f "$path/pyvenv.cfg" ] ;;
    *) return 0 ;;
  esac
}

# Find the nearest ancestor of DIR, bounded by BOUNDARY, that has project
# context. The result is placed in STALE_PROJECT_ROOT.
STALE_PROJECT_ROOT=""
stale_find_project_root() {
  local cur=$1 boundary=$2
  STALE_PROJECT_ROOT=""
  while :; do
    if stale_has_context "$cur"; then
      STALE_PROJECT_ROOT=$cur
      return 0
    fi
    [ "$cur" = "$boundary" ] && break
    case $cur in "$boundary"/*) ;; *) break ;; esac
    cur=${cur%/*}
  done
  return 1
}

# Portable mtime in seconds. GNU stat uses -c %Y, BSD/macOS stat uses -f %m.
stale_file_mtime() {
  local p=$1 m
  m=$(stat -c %Y "$p" 2>/dev/null) && {
    printf '%s\n' "$m"
    return 0
  }
  m=$(stat -f %m "$p" 2>/dev/null) && {
    printf '%s\n' "$m"
    return 0
  }
  return 1
}

stale_source_entries() {
  local proj="$1" path
  while IFS= read -r -d '' path; do
    printf '%s\0' "$path"
    [ -n "$path" ] || return 1
    # Ambiguous or tracked folders can contain source, even with a cache-like name.
    if [ "$path" != "$proj" ] && [ -d "$path" ] && [ ! -L "$path" ] &&
       stale_name_is_artifact "${path##*/}" && ! stale_safe_artifact "$path" "$proj"; then
      find "$path" -xdev -name .git -prune -o -print0 || { printf '\0'; return 1; }
    fi
  done < <(find "$proj" -xdev -name .git -prune -o \
      -type d \( "${STALE_FIND_NAME_ARGS[@]}" \) -prune -print0 -o -print0 || printf '\0')
}

# Newest mtime among source files of PROJ. Artifact trees and .git are pruned
# by find. Directories with their own project context are recorded and their
# files are skipped, which keeps nested projects independent. Symlinks are
# never considered. The result is placed in STALE_NEWEST_MTIME.
STALE_NEWEST_MTIME=""
stale_newest_source_mtime() {
  local proj=$1 boundary=$2
  local p d m max=0 skipped
  local -a pruned=()
  STALE_NEWEST_MTIME=""
  [ ${#STALE_FIND_NAME_ARGS[@]} -eq 0 ] && stale_build_find_name_args

  while IFS= read -r -d '' p; do
    [ -n "$p" ] || return 1
    if [ -d "$p" ] && [ ! -L "$p" ]; then
      if [ "$p" != "$proj" ] && stale_has_context "$p"; then
        pruned+=( "$p" )
      fi
      continue
    fi
    if [ ! -f "$p" ] || [ -L "$p" ]; then
      continue
    fi
    skipped=0
    if [ ${#pruned[@]} -gt 0 ]; then
      for d in "${pruned[@]}"; do
        case $p in
          "$d"/*) skipped=1; break ;;
        esac
      done
    fi
    [ "$skipped" -eq 1 ] && continue
    m=$(stale_file_mtime "$p") || return 1
    if [ "$m" -gt "$max" ]; then
      max=$m
    fi
  done < <(stale_source_entries "$proj")

  [ "$max" -gt 0 ] || return 1
  STALE_NEWEST_MTIME=$max
  return 0
}

# Decide staleness from source activity, never from artifact timestamps.
# Sets STALE_AGE_DAYS to whole days since the newest source change.
STALE_AGE_DAYS=""
stale_project_is_stale() {
  local proj=$1 boundary=$2 max
  [ -n "${STALE_DAYS:-}" ] || return 1
  if [ -z "${STALE_NOW:-}" ]; then
    STALE_NOW=$(date +%s) || return 1
  fi
  stale_newest_source_mtime "$proj" "$boundary" || return 1
  max=$STALE_NEWEST_MTIME
  if [ $(( STALE_NOW - max )) -lt $(( STALE_DAYS * 86400 )) ]; then
    return 1
  fi
  STALE_AGE_DAYS=$(( ( STALE_NOW - max ) / 86400 ))
  return 0
}

# Discover stale artifacts without deleting anything.
discover_stale() {
  STALE_PATHS=()
  STALE_AGES=()
  STALE_SIZES=()
  [ ${#STALE_FIND_NAME_ARGS[@]} -eq 0 ] && stale_build_find_name_args
  [ -n "${STALE_DAYS:-}" ] || { stale_invalid "STALE_DAYS is required"; return 1; }
  if [ -z "${STALE_ROOT_PHYSICAL:-}" ]; then
    validate_stale_root || return 1
  fi

  local root=$STALE_ROOT_PHYSICAL p base parent proj size
  STALE_NOW=$(date +%s) || return 1

  while IFS= read -r -d '' p; do
    [ -d "$p" ] && [ ! -L "$p" ] || continue
    case $p in "$root"/*) ;; *) continue ;; esac
    stale_path_has_git_component "$p" && continue
    stale_path_has_symlink_below "$p" "$root" && continue
    base=${p##*/}
    stale_name_is_artifact "$base" || continue
    parent=${p%/*}
    stale_find_project_root "$parent" "$root" || continue
    proj=$STALE_PROJECT_ROOT
    stale_safe_artifact "$p" "$proj" || continue
    stale_project_is_stale "$proj" "$root" || continue
    size=$(dir_bytes "$p") || continue
    STALE_PATHS+=( "$p" )
    STALE_AGES+=( "$STALE_AGE_DAYS" )
    STALE_SIZES+=( "$size" )
  done < <(find "$root" -xdev \
        -type d -name .git -prune -o \
        -type d \( "${STALE_FIND_NAME_ARGS[@]}" \) -prune -print0)

  return 0
}

# Recheck a candidate immediately before deletion. Success means the path is
# still an existing, non-symlink artifact directory under the validated root,
# still has project context, and its source is still older than the threshold.
stale_is_eligible() {
  local p=${1-} root=${STALE_ROOT_PHYSICAL:-} base parent proj
  [ -n "$p" ] || return 1
  [ -n "$root" ] || return 1
  case $p in "$root"/*) ;; *) return 1 ;; esac
  [ -d "$p" ] && [ ! -L "$p" ] || return 1
  stale_path_has_git_component "$p" && return 1
  stale_path_has_symlink_below "$p" "$root" && return 1
  base=${p##*/}
  stale_name_is_artifact "$base" || return 1
  parent=${p%/*}
  stale_find_project_root "$parent" "$root" || return 1
  proj=$STALE_PROJECT_ROOT
  stale_safe_artifact "$p" "$proj" || return 1
  STALE_NOW=$(date +%s) || return 1
  stale_project_is_stale "$proj" "$root" || return 1
  stale_artifact_has_no_git "$p" || return 1
  return 0
}

stale_artifact_has_no_git() {
  local match
  match=$(find "$1" -name .git -print -quit 2>/dev/null) && [ -z "$match" ]
}

probe_stale() {
  local i path size detail
  discover_stale || return 1
  for i in "${!STALE_PATHS[@]}"; do
    path="${STALE_PATHS[i]}"; size="${STALE_SIZES[i]}"
    if [ "$size" -lt 0 ] || ! stale_artifact_has_no_git "$path"; then continue; fi
    PROBE_TARGETS[${#PROBE_TARGETS[@]}]="$path"
    PROBE_KINDS[${#PROBE_KINDS[@]}]=dir
    PROBE_BYTES=$((PROBE_BYTES + size))
    printf -v detail '%q  %s  %s day(s) since source changed' "${path#"$STALE_ROOT"/}" "$(human "$size")" "${STALE_AGES[i]}"
    PROBE_DETAILS[${#PROBE_DETAILS[@]}]="$detail"
  done
  [ "${#PROBE_TARGETS[@]}" -gt 0 ]
}

clean_stale() { validate_stale_root && clean_targets; }

# ----------------------------------------------------------------------------
# Scan
# ----------------------------------------------------------------------------

AVAIL_IDX=()      # item indices with something to clean, in display order
MISSING=()        # labels of items with nothing to clean here
SCAN_NOTES=()
DETAIL_ITEMS=() DETAIL_TEXT=()
TARGET_ITEMS=() TARGET_PATHS=() TARGET_KINDS=()

# Sets BYTES[i] and NOTE[i]. Returns 1 when there is nothing to clean: the tool
# or folder is absent, or it is empty. Unused networks have no size (-1).
probe_item() {
  local i="$1"
  PROBE_BYTES=0; PROBE_NOTE=""
  PROBE_DETAILS=(); PROBE_TARGETS=(); PROBE_KINDS=()
  if "probe_${IDS[i]}"; then
    BYTES[i]="$PROBE_BYTES"; NOTE[i]="$PROBE_NOTE"; return 0
  fi
  BYTES[i]=-1; NOTE[i]=""; return 1
}

scan() {
  local i j k
  resolve_paths
  resolve_agent_paths
  load_docker_patterns
  progress "Docker"
  load_docker
  i=0
  while [ "$i" -lt "$N" ]; do
    progress "${LABEL[i]}"
    if probe_item "$i"; then
      AVAIL_IDX[${#AVAIL_IDX[@]}]=$i
      for j in "${!PROBE_TARGETS[@]}"; do
        k=${#TARGET_ITEMS[@]}
        TARGET_ITEMS[k]=$i; TARGET_PATHS[k]="${PROBE_TARGETS[j]}"; TARGET_KINDS[k]="${PROBE_KINDS[j]}"
      done
      for j in "${PROBE_DETAILS[@]}"; do
        k=${#DETAIL_ITEMS[@]}
        DETAIL_ITEMS[k]=$i; DETAIL_TEXT[k]="$j"
      done
    else
      MISSING[${#MISSING[@]}]="${LABEL[i]}"
    fi
    i=$((i + 1))
  done
  progress_done
}

SCAN_STEP=0
progress() {
  SCAN_STEP=$((SCAN_STEP + 1))
  [ "$IS_TTY" = 1 ] || return 0
  printf '\r\033[K  %s%s%s Scanning %s%s%s' "$C_CYAN" "${FRAMES[$((SCAN_STEP % ${#FRAMES[@]}))]}" "$C_RESET" "$C_DIM" "$1" "$C_RESET"
}
progress_done() { [ "$IS_TTY" = 1 ] && printf '\r\033[K'; SCAN_STEP=0; return 0; }

# ----------------------------------------------------------------------------
# Usage table
# ----------------------------------------------------------------------------

NUM_TO_IDX=()     # display number (1-based) to item index

print_table() {
  local max=0 total=0 pos=0 i j b group="" num
  NUM_TO_IDX=()
  for i in "${AVAIL_IDX[@]}"; do
    b=${BYTES[i]}
    [ "$b" -gt "$max" ] && max=$b
    [ "$b" -gt 0 ] && total=$((total + b))
  done
  for i in "${AVAIL_IDX[@]}"; do
    pos=$((pos + 1)); NUM_TO_IDX[pos]=$i
    if [ "${GROUP[i]}" != "$group" ]; then group="${GROUP[i]}"; section "$group"; fi
    num=$(printf '%2d' "$pos")
    printf '   %s%s%s  %-42s %10s  %s  %s\n' "$C_BOLD" "$num" "$C_RESET" "${LABEL[i]}" "$(human "${BYTES[i]}")" "$(bar "${BYTES[i]}" "$max")" "$(risk_badge "${RISK[i]}")"
    [ -n "${NOTE[i]}" ] && printf '       %s%s%s\n' "$C_DIM" "${NOTE[i]}" "$C_RESET"
    for j in "${!DETAIL_ITEMS[@]}"; do
      [ "${DETAIL_ITEMS[j]}" != "$i" ] || printf '       %s\n' "${DETAIL_TEXT[j]}"
    done
  done
  if [ "${#AVAIL_IDX[@]}" -eq 0 ]; then note "Nothing to clean was found."; fi
  echo
  info "$(printf '%sListed:%s %s across %d item(s)    %sDisk free:%s %s of %s' \
    "$C_BOLD" "$C_RESET" "$(human "$total")" "${#AVAIL_IDX[@]}" \
    "$C_BOLD" "$C_RESET" "$(human "$(disk_free_bytes)")" "$(human "$(disk_total_bytes)")")"
  [ "$DOCKER_OK" = 1 ] || note "Docker items hidden: $DOCKER_WHY."
  for j in "${SCAN_NOTES[@]}"; do note "$j"; done
  if [ "${#MISSING[@]}" -gt 0 ]; then
    local cols; cols=$(tput cols 2>/dev/null || echo 80); [ "$cols" -gt 20 ] || cols=80
    printf 'Nothing to clean (%d): %s.\n' "${#MISSING[@]}" "$(printf '%s, ' "${MISSING[@]}" | sed 's/, $//')" \
      | fold -s -w $((cols - 4)) | while IFS= read -r wrapped; do note "$wrapped"; done
  fi
}

# ----------------------------------------------------------------------------
# Selection
# ----------------------------------------------------------------------------

SELECTED=()       # item indices, in execution (display) order
SEL_ERROR=""

contains() { local x="$1"; shift; local y; for y in "$@"; do [ "$x" = "$y" ] && return 0; done; return 1; }

selection_number() {
  local number="$1"
  case "$number" in ''|*[!0-9]*) return 1 ;; esac
  number="${number#"${number%%[!0]*}"}"
  [ "${#number}" -le 6 ] || return 1
  printf '%s\n' "${number:-0}"
}

# Parses a selection into SELECTED. Returns 1 with SEL_ERROR set on bad input.
parse_selection() {
  local input="$1" tok lo hi n idx count="${#AVAIL_IDX[@]}" i
  local picked=() tokens=()
  SEL_ERROR=""
  input="${input//$'\n'/ }"
  IFS=$' ,\t' read -r -a tokens <<< "$input"
  for tok in "${tokens[@]}"; do
    case "$tok" in
      safe|s)
        for i in "${AVAIL_IDX[@]}"; do [ "${RISK[i]}" = "safe" ] && picked[${#picked[@]}]=$i; done ;;
      all|a)
        for i in "${AVAIL_IDX[@]}"; do
          if [ "${RISK[i]}" != danger ] && [ "${IDS[i]}" != stale ]; then picked[${#picked[@]}]=$i; fi
        done ;;
      *-*)
        if ! lo=$(selection_number "${tok%%-*}") || ! hi=$(selection_number "${tok#*-}"); then
          SEL_ERROR="'$tok' is not a range"; return 1
        fi
        if [ "$lo" -lt 1 ] || [ "$hi" -gt "$count" ] || [ "$lo" -gt "$hi" ]; then SEL_ERROR="range '$tok' is outside 1-$count"; return 1; fi
        n=$lo; while [ "$n" -le "$hi" ]; do picked[${#picked[@]}]=${NUM_TO_IDX[n]}; n=$((n + 1)); done ;;
      *[!0-9]*)
        idx=""
        for i in "${AVAIL_IDX[@]}"; do [ "${IDS[i]}" = "$tok" ] && idx=$i; done
        [ -n "$idx" ] || { SEL_ERROR="unknown item '$tok'"; return 1; }
        picked[${#picked[@]}]=$idx ;;
      *)
        if ! n=$(selection_number "$tok") || [ "$n" -lt 1 ] || [ "$n" -gt "$count" ]; then SEL_ERROR="'$tok' is not between 1 and $count"; return 1; fi
        picked[${#picked[@]}]=${NUM_TO_IDX[n]} ;;
    esac
  done
  SELECTED=()
  for i in "${AVAIL_IDX[@]}"; do
    if [ "${#picked[@]}" -gt 0 ] && contains "$i" "${picked[@]}"; then SELECTED[${#SELECTED[@]}]=$i; fi
  done
  [ "${#SELECTED[@]}" -gt 0 ] || { SEL_ERROR="nothing selected"; return 1; }
  return 0
}

ask_selection() {
  local answer
  while :; do
    echo
    printf '  %s%s%s Choose items: numbers, ranges or names (e.g. %s1 3 5-7%s), %ss%s = all safe, %sa%s = safe + caution, %sq%s = quit\n' \
      "$C_MAGENTA" "$G_ARROW" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET"
    printf '  %s%s%s ' "$C_MAGENTA" "$G_ARROW" "$C_RESET"
    if ! IFS= read -r answer; then echo; exit 0; fi
    case "$answer" in
      q|Q|quit|exit) note "Nothing changed."; exit 0 ;;
      "") continue ;;
    esac
    if parse_selection "$answer"; then return 0; fi
    fail "$SEL_ERROR"
  done
}

# ----------------------------------------------------------------------------
# Plan and confirmation
# ----------------------------------------------------------------------------

print_plan() {
  local i est=0 has_danger=0
  section "Plan"
  for i in "${SELECTED[@]}"; do
    [ "${BYTES[i]}" -gt 0 ] && est=$((est + BYTES[i]))
    [ "${RISK[i]}" = "danger" ] && has_danger=1
    printf '   %s%s%s %-42s %10s  %s\n' "$C_CYAN" "$G_DOT" "$C_RESET" "${LABEL[i]}" "$(human "${BYTES[i]}")" "$(risk_badge "${RISK[i]}")"
    printf '       %s%s%s\n' "$C_DIM" "${ACTION[i]}" "$C_RESET"
    if [ "${IDS[i]}" = dk_custom ]; then
      local ref
      for ref in "${MATCHED_IMAGES[@]}"; do printf '       %s\n' "$ref"; done
    fi
  done
  echo
  info "$(printf '%sUp to %s%s could be freed (the real figure is shown afterwards).' "$C_BOLD" "$(human "$est")" "$C_RESET")"
  PLAN_HAS_DANGER=$has_danger
}

confirm() {
  local answer
  if [ "$PLAN_HAS_DANGER" = 1 ]; then
    echo
    warn "The plan includes danger items that can lose data."
    printf '  %sType "yes" to continue:%s ' "$C_BOLD$C_RED" "$C_RESET"
    IFS= read -r answer || answer=""
    [ "$answer" = "yes" ]
    return
  fi
  printf '\n  %sProceed?%s [y/N] ' "$C_BOLD" "$C_RESET"
  IFS= read -r answer || answer=""
  case "$answer" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
}

# ----------------------------------------------------------------------------
# Cleaning
# ----------------------------------------------------------------------------

CURRENT_PID=""
LOG=""

on_interrupt() {
  trap '' INT TERM
  if [ -n "$CURRENT_PID" ]; then
    # Monitor mode gives this step and its children a separate process group.
    kill -TERM -- "-$CURRENT_PID" 2>/dev/null || :
    sleep 0.2
    kill -KILL -- "-$CURRENT_PID" 2>/dev/null || :
    wait "$CURRENT_PID" 2>/dev/null || :
  fi
  [ "$IS_TTY" = 1 ] && { tput cnorm 2>/dev/null; printf '\r\033[K'; }
  echo
  warn "Interrupted. Items already cleaned stay cleaned."
  [ -n "$LOG" ] && note "Log: $LOG"
  exit 130
}
trap on_interrupt INT TERM
trap '[ "$IS_TTY" = 1 ] && tput cnorm 2>/dev/null' EXIT

start_log() {
  local old i limit logs=() LC_ALL=C
  if home_path "$LOG_DIR"; then
    LOG_DIR="$VALID_PATH"
  else
    stale_normalize_physical "$LOG_DIR" || return 1
    LOG_DIR="$STALE_NORMALIZED"
  fi
  (umask 077; mkdir -p -- "$LOG_DIR") || return 1
  LOG=$(umask 077; mktemp "$LOG_DIR/cleancodeshit-$(date +%Y%m%d-%H%M%S).XXXXXX") || return 1
  {
    echo "cleancodeshit $VERSION run at $(date)"
    echo "user $(id -un) on $(uname -srm)"
    echo "disk free before: $(human "$(disk_free_bytes)")"
  } >"$LOG"
  # Keep the latest 20 of our logs when the directory is inside the home jail.
  if home_path "$LOG_DIR"; then
    for old in "$LOG_DIR"/cleancodeshit-????????-??????.??????; do
      [ -f "$old" ] && [ ! -L "$old" ] || continue
      logs[${#logs[@]}]="$old"
    done
    limit=$((${#logs[@]} - 20))
    for (( i=0; i<limit; i++ )); do
      [ "${logs[i]}" = "$LOG" ] || safe_rm "${logs[i]}" >/dev/null || :
    done
  fi
  return 0
}

run_item() {
  local i="$1" label start rc frame=0
  label="${LABEL[i]}"
  start=$(date +%s)
  printf '\n===== %s (%s) =====\n' "$label" "${IDS[i]}" >>"$LOG"
  INTERRUPT_PENDING=0
  trap 'INTERRUPT_PENDING=1' INT TERM
  (
    set +m
    ITEM_INDEX="$i"
    if [ "${GROUP[i]}" = Docker ] && ! docker_endpoint_unchanged; then
      fail "The selected Docker endpoint changed. Skipping cleanup."
      exit 1
    fi
    "clean_${IDS[i]}"
  ) >>"$LOG" 2>&1 &
  CURRENT_PID=$!
  trap on_interrupt INT TERM
  [ "$INTERRUPT_PENDING" = 0 ] || on_interrupt
  if [ "$IS_TTY" = 1 ]; then
    tput civis 2>/dev/null
    while kill -0 "$CURRENT_PID" 2>/dev/null; do
      printf '\r\033[K   %s%s%s %s %s(%ss)%s' "$C_CYAN" "${FRAMES[frame]}" "$C_RESET" "$label" "$C_DIM" "$(( $(date +%s) - start ))" "$C_RESET"
      frame=$(( (frame + 1) % ${#FRAMES[@]} ))
      sleep 0.1
    done
    printf '\r\033[K'
    tput cnorm 2>/dev/null
  fi
  wait "$CURRENT_PID"; rc=$?
  CURRENT_PID=""
  RC[i]=$rc; DUR[i]=$(( $(date +%s) - start ))
  echo "exit $rc after ${DUR[i]}s" >>"$LOG"
  if [ "$rc" -eq 0 ]; then
    printf '   %s%s%s %-42s %s%ss%s\n' "$C_GREEN" "$G_OK" "$C_RESET" "$label" "$C_DIM" "${DUR[i]}" "$C_RESET"
  else
    printf '   %s%s%s %-42s %sfailed (exit %s), see the log%s\n' "$C_RED" "$G_FAIL" "$C_RESET" "$label" "$C_RED" "$rc" "$C_RESET"
  fi
}

# ----------------------------------------------------------------------------
# Report
# ----------------------------------------------------------------------------

report() {
  local i before after freed total=0 failed=0 status
  section "Result"
  printf '   %s%-44s %10s %10s %10s%s\n' "$C_DIM" "" "before" "after" "freed" "$C_RESET"
  for i in "${SELECTED[@]}"; do
    before=${BEFORE[i]}
    after=${BYTES[i]}
    [ "$after" -lt 0 ] && after=0
    freed=0
    if [ "$before" -gt 0 ] && [ "$before" -gt "$after" ]; then freed=$((before - after)); fi
    total=$((total + freed))
    if [ "${RC[i]}" -eq 0 ]; then status="$C_GREEN$G_OK$C_RESET"; else status="$C_RED$G_FAIL$C_RESET"; failed=$((failed + 1)); fi
    if [ "$before" -lt 0 ]; then
      printf '   %s %-42s %10s %10s %10s\n' "$status" "${LABEL[i]}" "-" "-" "-"
    else
      printf '   %s %-42s %10s %10s %s%10s%s\n' "$status" "${LABEL[i]}" "$(human "$before")" "$(human "$after")" "$C_BOLD$C_GREEN" "$(human "$freed")" "$C_RESET"
    fi
  done
  echo
  info "$(printf '%sFreed:%s %s%s%s    %sDisk free:%s %s %s %s' \
    "$C_BOLD" "$C_RESET" "$C_BOLD$C_GREEN" "$(human "$total")" "$C_RESET" \
    "$C_BOLD" "$C_RESET" "$(human "$DISK_BEFORE")" "$G_ARROW" "$(human "$(disk_free_bytes)")")"
  [ "$failed" -gt 0 ] && warn "$failed item(s) failed. Details are in the log."
  note "Log: $LOG"
  echo "freed $(human "$total"); disk free after: $(human "$(disk_free_bytes)")" >>"$LOG"
  [ "$failed" -eq 0 ]
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------

[ -n "$HOME_PHYSICAL" ] && [ "$HOME_PHYSICAL" != / ] || { fail "HOME must be a user directory."; exit 1; }
if [ "$STALE_REQUESTED" = 1 ]; then
  validate_stale_root || exit 2
elif [ "$STALE_DAYS_SET" = 1 ]; then
  fail "--older-than requires --in."
  exit 2
fi

banner
scan
print_table

[ "$MODE" = "list" ] && exit 0
if [ "${#AVAIL_IDX[@]}" -eq 0 ]; then
  case "$PRESELECT" in
    ''|s|safe|a|all) ;;
    *) fail "--select: no items are available"; exit 2 ;;
  esac
  [ "$DRY_RUN" = 0 ] || note "Dry run: nothing was changed."
  exit 0
fi

if [ -n "$PRESELECT" ]; then
  if ! parse_selection "$PRESELECT"; then
    if [ "$SEL_ERROR" = 'nothing selected' ] && { [ "$PRESELECT" = safe ] || [ "$PRESELECT" = all ]; }; then
      note "No items match the selected preset."
      [ "$DRY_RUN" = 0 ] || note "Dry run: nothing was changed."
      exit 0
    fi
    fail "--select: $SEL_ERROR"
    exit 2
  fi
elif [ -t 0 ]; then
  ask_selection
else
  fail "No terminal to ask on. Use --select ITEMS (and --yes) to run without prompts."
  exit 2
fi

print_plan

if [ "$ASSUME_YES" = 1 ] && [ "$PLAN_HAS_DANGER" = 1 ]; then
  fail "--yes does not cover danger items. Run without --yes and type \"yes\" to confirm them."
  exit 2
fi

if [ "$DRY_RUN" = 1 ]; then
  echo
  note "Dry run: nothing was changed."
  exit 0
fi

if [ "$ASSUME_YES" = 0 ]; then
  [ -t 0 ] || { fail "No terminal to confirm on. Add --yes to run without a prompt."; exit 2; }
  if ! confirm; then note "Cancelled. Nothing changed."; exit 0; fi
fi

for i in "${SELECTED[@]}"; do BEFORE[i]=${BYTES[i]}; done
DISK_BEFORE=$(disk_free_bytes)
start_log || { fail "Could not create the cleanup log. Nothing changed."; exit 1; }

section "Cleaning"
set -m
for i in "${SELECTED[@]}"; do run_item "$i"; done
set +m

# Measure again: Docker figures come from a fresh `docker system df`.
progress "results"
resolve_paths
load_docker
for i in "${SELECTED[@]}"; do probe_item "$i" >/dev/null 2>&1 || BYTES[i]=0; done
progress_done

report
exit $?
