# Maintainer: Neel Banker <neelbanker1@gmail.com>
pkgname=cleancodeshit
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Interactive cleanup for AI coding agent and developer caches'
arch=('any')
options=('docs' '!debug' '!strip')
url='https://cleancodeshit.app'
license=('MIT')
depends=('bash' 'coreutils' 'findutils' 'gawk' 'grep' 'sed' 'procps-ng' 'ncurses')
optdepends=(
  'docker: audit and clean Docker objects'
  'npm: clean the npm download cache'
  'pnpm: prune the pnpm store'
  'yarn: populate the Yarn caches scanned by the cleaner'
  'uv: prune unused uv cache entries'
  'go: clean the Go build cache'
  'rust: populate the Cargo crate cache scanned by the cleaner'
  'ollama: list locally downloaded models'
  'git: inspect tracked files before cleaning stale build artifacts'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/bankerneel/cleancodeshit/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 cleancodeshit "$pkgdir/usr/bin/cleancodeshit"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/items.md "$pkgdir/usr/share/doc/$pkgname/items.md"
}
