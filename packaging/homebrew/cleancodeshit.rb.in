class Cleancodeshit < Formula
  desc "Interactive cleanup for AI coding agent and developer caches"
  homepage "https://github.com/bankerneel/cleancodeshit"
  url "https://github.com/bankerneel/cleancodeshit/archive/refs/tags/v2.1.0.tar.gz"
  sha256 "@TARBALL_SHA256@"
  license "MIT"

  def install
    bin.install "cleancodeshit"
  end

  test do
    assert_match "cleancodeshit 2.1.0", shell_output("#{bin}/cleancodeshit --version")
  end
end
